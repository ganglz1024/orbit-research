# Export these as process environment variables. Spring does not automatically read this file.
SPRING_PROFILES_ACTIVE=local
ORBIT_PORT=8080
# First initialization: create your account with a username and password at /settings.
# Optional base64-encoded 32-byte AES key. If blank, a persistent key is created at data/config.key.
# Back up that key with the database; never commit it or return it from the API.
ORBIT_CONFIG_ENCRYPTION_KEY=
ORBIT_CONFIG_KEY_PATH=./data/config.key
# Include /v1 in the base URL; the gateway appends /chat/completions.
ORBIT_LLM_BASE_URL=
ORBIT_LLM_MODEL=
ORBIT_LLM_API_KEY=
ORBIT_LLM_TIMEOUT_SECONDS=120
ORBIT_LLM_MAX_OUTPUT_TOKENS=2048
# Choose max_completion_tokens for models that require that parameter.
ORBIT_LLM_TOKEN_PARAMETER=max_tokens
# Enable only if your selected provider supports stream_options.include_usage.
ORBIT_LLM_INCLUDE_USAGE=false
# A deployment-only opt-in for a trusted local model endpoint; never controlled by API input.
ORBIT_LLM_ALLOW_PRIVATE_HOSTS=false
# MySQL: SPRING_PROFILES_ACTIVE=mysql
ORBIT_DB_URL=jdbc:mysql://127.0.0.1:3306/orbit?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
ORBIT_DB_USER=orbit
ORBIT_DB_PASSWORD=
ORBIT_COOKIE_SECURE=false
